LISTEN_ADDR=127.0.0.1:8080
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Bocha Jev (optional; without key, use mock provider)
BOCHA_JEV_API_KEY=
BOCHA_JEV_TIMEOUT=15s
BOCHA_JEV_MAX_QPS=2
BOCHA_JEV_MAX_FPS=2

# Laya local models — missing package is downloaded from Hub before listen
LAYA_MODEL_CACHE_DIR=
LAYA_MODEL_ID=aac6fef/laya-multilingual-coreml-ane
LAYA_MODEL_DIR=models/snake
LAYA_MODEL_REVISION=
HF_TOKEN=
